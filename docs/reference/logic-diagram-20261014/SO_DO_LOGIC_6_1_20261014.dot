}
subgraph cluster_entry { label="ĐĂNG KÝ VÀ THI ĐẦU VÀO"; fontsize=15; fontname="Arial"; style="rounded,filled"; color="#aaaaaa"; fillcolor="#f7f7f7"; penwidth=0.7; margin=22;

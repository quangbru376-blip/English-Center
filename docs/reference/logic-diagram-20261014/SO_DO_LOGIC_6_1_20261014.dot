digraph Logic {
graph [rankdir=RL, newrank=true, compound=true, splines=polyline, nodesep=0.33, ranksep=0.65, bgcolor="white", pad=0.35, fontname="Arial", fontsize=22, labelloc=t, label="SƠ ĐỒ LOGIC DỮ LIỆU
Hệ thống quản lý trung tâm tiếng Anh", outputorder=edgesfirst];
node [shape=box, style="filled", fillcolor="white", color="#202020", penwidth=1.2, fontname="Arial", fontsize=17, margin="0.13,0.14"];
edge [color="#484848", penwidth=1.1, arrowsize=0.75, fontname="Arial", fontsize=11];
subgraph cluster_identity { label="TÀI KHOẢN VÀ PHIÊN"; fontsize=15; fontname="Arial"; style="rounded,filled"; color="#aaaaaa"; fillcolor="#f7f7f7"; penwidth=0.7; margin=22;
Role [label="Role"];
Account [label="Account"];
StudentProfile [label="StudentProfile"];
AuthSession [label="AuthSession"];
}
subgraph cluster_config { label="CẤU HÌNH ĐÀO TẠO"; fontsize=15; fontname="Arial"; style="rounded,filled"; color="#aaaaaa"; fillcolor="#f7f7f7"; penwidth=0.7; margin=22;
Course [label="Course"];
Band [label="Band"];
TrainingProgram [label="TrainingProgram"];

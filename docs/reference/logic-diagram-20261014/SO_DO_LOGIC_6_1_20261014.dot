Schedule [label="Schedule"];
Attendance [label="Attendance"];
Score [label="Score"];
GradeReport [label="GradeReport"];
}
subgraph cluster_finance { label="HÓA ĐƠN VÀ THANH TOÁN"; fontsize=15; fontname="Arial"; style="rounded,filled"; color="#aaaaaa"; fillcolor="#f7f7f7"; penwidth=0.7; margin=22;
Invoice [label="Invoice"];
Payment [label="Payment"];
InvoiceNumberCounter [label="InvoiceNumberCounter\nBộ cấp số theo năm; không có FK"];
}

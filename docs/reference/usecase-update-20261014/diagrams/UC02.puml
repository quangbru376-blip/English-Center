@startuml
left to right direction
skinparam monochrome true
skinparam shadowing false
actor "Học viên" as A_s
actor "Tuyển sinh" as A_ad
rectangle "Hệ thống quản lý trung tâm Anh ngữ" {
usecase "Xem khóa học đang hoạt động" as U_courses
usecase "Tạo hồ sơ đăng ký khóa học" as U_create
usecase "Xem hồ sơ của mình" as U_own
usecase "Hủy hồ sơ trước xác nhận" as U_cancelown
usecase "Xác nhận nhập học" as U_confirm
usecase "Tra cứu và kiểm tra hồ sơ" as U_search
usecase "Duyệt hồ sơ nhập học" as U_approve
usecase "Từ chối hồ sơ có lý do" as U_reject
usecase "Hủy hồ sơ theo quyền Tuyển sinh" as U_cancel
usecase "Phát hành một hóa đơn học phí" as U_invoice
}
A_s -- U_courses
A_s -- U_create
A_s -- U_own
A_s -- U_cancelown
A_s -- U_confirm
A_ad -- U_search
A_ad -- U_approve
A_ad -- U_reject
A_ad -- U_cancel
U_approve ..> U_invoice : <<include>>
@enduml
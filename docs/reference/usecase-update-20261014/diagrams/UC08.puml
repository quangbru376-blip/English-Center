@startuml
left to right direction
skinparam monochrome true
skinparam shadowing false
actor "Giám đốc" as A_di
actor "Kế toán" as A_ac
rectangle "Hệ thống quản lý trung tâm Anh ngữ" {
usecase "Xem báo cáo tuyển sinh tổng hợp" as U_admissions
usecase "Xem báo cáo đào tạo và tỷ lệ đạt" as U_training
usecase "Xem báo cáo tài chính tổng hợp" as U_finance
usecase "Xem báo cáo học phí theo quyền" as U_accountant
usecase "Xuất CSV tài chính toàn tập lọc" as U_csv
usecase "Truy vấn mới kết quả tài chính" as U_fresh
}
A_di -- U_admissions
A_di -- U_training
A_di -- U_finance
A_ac -- U_accountant
A_ac -- U_csv
U_csv ..> U_fresh : <<include>>
@enduml
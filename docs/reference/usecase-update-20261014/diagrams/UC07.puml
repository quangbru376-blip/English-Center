@startuml
left to right direction
skinparam monochrome true
skinparam shadowing false
actor "Giáo viên" as A_t
actor "Giáo vụ" as A_aa
actor "Học viên" as A_s
rectangle "Hệ thống quản lý trung tâm Anh ngữ" {
usecase "Xem lớp danh sách và lịch được giao" as U_classes
usecase "Ghi hoặc sửa điểm danh một buổi" as U_attendance
usecase "Lưu điểm nháp và nhận xét một học viên" as U_draft
usecase "Gửi bảng điểm cả lớp" as U_submit
usecase "Sửa và gửi lại lớp bị trả" as U_resubmit
usecase "Xem bảng điểm theo quyền Giáo vụ" as U_review
usecase "Trả lại cả lớp có lý do" as U_return
usecase "Chốt và công bố cả lớp" as U_finalize
usecase "Tính và lưu điểm tổng kết chính thức" as U_total
usecase "Xem kết quả cá nhân đã chốt" as U_published
}
A_t -- U_classes
A_t -- U_attendance
A_t -- U_draft
A_t -- U_submit
A_t -- U_resubmit
A_aa -- U_review
A_aa -- U_return
A_aa -- U_finalize
A_s -- U_published
U_finalize ..> U_total : <<include>>
@enduml
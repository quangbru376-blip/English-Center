@startuml
left to right direction
skinparam monochrome true
skinparam shadowing false
actor "Học viên" as A_s
actor "Tuyển sinh" as A_ad
actor "Giáo viên" as A_t
actor "Quản trị viên" as A_admin
actor "Giáo vụ" as A_aa
actor "Kế toán" as A_ac
actor "Giám đốc" as A_di
rectangle "Hệ thống quản lý trung tâm Anh ngữ" {
usecase "Tự đăng ký và theo dõi việc học" as U_student
usecase "Xử lý hồ sơ tuyển sinh" as U_admissions
usecase "Thi đầu vào và giảng dạy" as U_teacher
usecase "Quản trị tài khoản và nhật ký" as U_staff
usecase "Cấu hình lớp lịch và duyệt điểm" as U_acad
usecase "Học phí thanh toán và CSV" as U_finance
usecase "Báo cáo quản lý tổng hợp" as U_reports
}
A_s -- U_student
A_ad -- U_admissions
A_t -- U_teacher
A_admin -- U_staff
A_aa -- U_acad
A_ac -- U_finance
A_di -- U_reports
@enduml
@startuml
left to right direction
skinparam monochrome true
skinparam shadowing false
actor "Học viên" as A_s
actor "Giáo vụ" as A_aa
actor "Giáo viên chấm" as A_t
rectangle "Hệ thống quản lý trung tâm Anh ngữ" {
usecase "Xem ca phù hợp và lịch của mình" as U_slots
usecase "Đặt đổi hủy hoặc đặt lại ca thi" as U_booking
usecase "Xem kết quả từng lượt và Band" as U_results
usecase "Tạo mở đóng hủy hoặc sửa ca thi" as U_session
usecase "Phân công hoặc đổi người chấm" as U_grader
usecase "Theo dõi kết quả và tiến độ chấm" as U_follow
usecase "Xem ca và danh sách được giao" as U_assigned
usecase "Nhập điểm đầu vào" as U_grade
usecase "Ghi nhận vắng thi" as U_absent
usecase "Sửa điểm đầu vào có lý do" as U_correct
usecase "Tính lại điểm tốt nhất và Band" as U_band
}
A_s -- U_slots
A_s -- U_booking
A_s -- U_results
A_aa -- U_session
A_aa -- U_grader
A_aa -- U_follow
A_t -- U_assigned
A_t -- U_grade
A_t -- U_absent
A_t -- U_correct
U_grade ..> U_band : <<include>>
U_correct ..> U_band : <<include>>
@enduml
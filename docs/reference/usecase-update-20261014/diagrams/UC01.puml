@startuml
left to right direction
skinparam monochrome true
skinparam shadowing false
actor "Người dùng\n7 vai trò" as A_u
actor "Học viên" as A_s
actor "Quản trị viên" as A_admin
rectangle "Hệ thống quản lý trung tâm Anh ngữ" {
usecase "Đăng nhập" as U_login
usecase "Đăng xuất phiên hiện tại" as U_logout
usecase "Tự đổi mật khẩu" as U_pass
usecase "Tự đăng ký tài khoản Học viên" as U_signup
usecase "Sửa hồ sơ cá nhân của mình" as U_profile
usecase "Cấp tài khoản nhân sự" as U_create
usecase "Đặt lại mật khẩu tạm" as U_reset
usecase "Khóa hoặc mở khóa tài khoản" as U_lock
usecase "Ngừng hoặc khôi phục tài khoản" as U_disable
usecase "Thu hồi các phiên liên quan" as U_revoke
}
A_u -- U_login
A_u -- U_logout
A_u -- U_pass
A_s -- U_signup
A_s -- U_profile
A_admin -- U_create
A_admin -- U_reset
A_admin -- U_lock
A_admin -- U_disable
U_pass ..> U_revoke : <<include>>
U_reset ..> U_revoke : <<include>>
@enduml